{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/NdfTechLabs/dt_master/blob/develop/docs/migrations/schemas/infrastructure-node-docker-readiness-requirements-v1.schema.json",
  "title": "Infrastructure Node Docker Readiness Requirements",
  "description": "Versioned policy input for deterministic Docker readiness evaluation. Values are configured by an approved policy owner; no thresholds are implied by this schema.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "requirements_version",
    "checks"
  ],
  "properties": {
    "requirements_version": {
      "const": "1.0.0"
    },
    "max_snapshot_age_seconds": {
      "type": "integer",
      "minimum": 1
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "severity",
          "expected"
        ],
        "properties": {
          "key": {
            "enum": [
              "docker_engine_required",
              "docker_compose_required",
              "min_cpu_cores",
              "min_total_memory_bytes",
              "min_available_memory_bytes",
              "min_available_storage_bytes",
              "min_engine_version",
              "min_compose_version"
            ]
          },
          "severity": {
            "enum": [
              "required",
              "recommended"
            ]
          },
          "expected": {
            "oneOf": [
              {
                "type": "boolean"
              },
              {
                "type": "number",
                "exclusiveMinimum": 0
              },
              {
                "type": "string",
                "pattern": "^v?\\\\d+(\\\\.\\\\d+){1,3}$"
              }
            ]
          }
        }
      }
    }
  }
}\n