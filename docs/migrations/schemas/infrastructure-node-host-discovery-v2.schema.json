{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ndftechlabs.com/schemas/infrastructure-node-host-discovery-v2.schema.json",
  "title": "Infrastructure Node Host Discovery v2",
  "description": "Read-only Linux host inventory. This schema describes host facts, not Bench ownership or application readiness.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "observed_at", "identity", "os", "compute", "storage", "network", "tools", "services", "bench_available"],
  "properties": {
    "schema_version": {"const": "2.0.0"},
    "observed_at": {"type": "string", "format": "date-time"},
    "identity": {
      "type": "object", "additionalProperties": false, "required": ["hostname", "fqdn"],
      "properties": {"hostname": {"type": "string", "maxLength": 253}, "fqdn": {"type": "string", "maxLength": 253}}
    },
    "os": {
      "type": "object", "additionalProperties": false,
      "required": ["pretty_name", "id", "version_id", "version_codename", "id_like", "kernel_release", "kernel_version", "architecture", "package_manager", "service_manager", "timezone"],
      "properties": {
        "pretty_name": {"type": "string", "maxLength": 200}, "id": {"type": "string", "maxLength": 40},
        "version_id": {"type": "string", "maxLength": 40}, "version_codename": {"type": "string", "maxLength": 80},
        "id_like": {"type": "string", "maxLength": 160}, "kernel_release": {"type": "string", "maxLength": 160},
        "kernel_version": {"type": "string", "maxLength": 255}, "architecture": {"type": "string", "maxLength": 40},
        "package_manager": {"type": "string", "maxLength": 40}, "service_manager": {"type": "string", "maxLength": 40},
        "timezone": {"type": "string", "maxLength": 80}
      }
    },
    "compute": {
      "type": "object", "additionalProperties": false,
      "required": ["cpu_model", "logical_cpu_cores", "memory_total_bytes", "memory_available_bytes", "swap_total_bytes", "swap_free_bytes", "load_average", "uptime_seconds", "virtualization"],
      "properties": {
        "cpu_model": {"type": "string", "maxLength": 255}, "logical_cpu_cores": {"type": "integer", "minimum": 0},
        "memory_total_bytes": {"type": "integer", "minimum": 0}, "memory_available_bytes": {"type": "integer", "minimum": 0},
        "swap_total_bytes": {"type": "integer", "minimum": 0}, "swap_free_bytes": {"type": "integer", "minimum": 0},
        "load_average": {"type": "array", "items": {"type": "number", "minimum": 0}, "maxItems": 3},
        "uptime_seconds": {"type": ["integer", "null"], "minimum": 0}, "virtualization": {"type": "string", "maxLength": 80}
      }
    },
    "storage": {
      "type": "object", "additionalProperties": false, "required": ["filesystems", "root_available_bytes", "root_size_bytes"],
      "properties": {
        "root_available_bytes": {"type": "integer", "minimum": 0}, "root_size_bytes": {"type": "integer", "minimum": 0},
        "filesystems": {"type": "array", "maxItems": 64, "items": {"type": "object", "required": ["filesystem", "type", "size_bytes", "used_bytes", "available_bytes", "used_percent", "mountpoint"], "properties": {
          "filesystem": {"type": "string", "maxLength": 255}, "type": {"type": "string", "maxLength": 40},
          "size_bytes": {"type": "integer", "minimum": 0}, "used_bytes": {"type": "integer", "minimum": 0},
          "available_bytes": {"type": "integer", "minimum": 0}, "used_percent": {"type": "integer", "minimum": 0, "maximum": 100},
          "mountpoint": {"type": "string", "maxLength": 512}
        }}}
      }
    },
    "network": {
      "type": "object", "additionalProperties": false, "required": ["interfaces", "default_routes", "dns_nameservers", "listening_sockets"],
      "properties": {
        "interfaces": {"type": "array", "maxItems": 32, "items": {"type": "object"}},
        "default_routes": {"type": "array", "maxItems": 16, "items": {"type": "object"}},
        "dns_nameservers": {"type": "array", "items": {"type": "string"}, "maxItems": 16},
        "listening_sockets": {"type": "array", "maxItems": 256, "items": {"type": "object", "required": ["protocol", "local_address"], "properties": {"protocol": {"type": "string"}, "local_address": {"type": "string"}}}}
      }
    },
    "tools": {"type": "object", "additionalProperties": {"type": "boolean"}},
    "services": {"type": "object", "additionalProperties": {"type": "object"}},
    "bench_available": {"type": "boolean"}
  }
}
