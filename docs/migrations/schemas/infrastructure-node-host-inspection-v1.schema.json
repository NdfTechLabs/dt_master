{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/NdfTechLabs/dt_master/blob/develop/docs/migrations/schemas/infrastructure-node-host-inspection-v1.schema.json",
  "title": "Infrastructure Node Host Inspection Snapshot",
  "description": "Versioned read-only observation of Host identity, platform management capabilities and machine capacity. OS support status is an observation against the DT Master server-owned support matrix; it is not baseline readiness.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "inspection_status",
    "hostname",
    "os",
    "os_id",
    "os_version_id",
    "os_version_codename",
    "os_id_like",
    "raw_architecture",
    "architecture",
    "package_manager",
    "service_manager",
    "os_support_policy_version",
    "os_support_status",
    "cpu_cores",
    "memory_bytes",
    "root_available_bytes",
    "bench_available"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "inspection_status": { "enum": ["Successful", "Partial", "Failed", "Timed Out", "Invalid"] },
    "hostname": { "type": "string", "minLength": 1, "maxLength": 253 },
    "os": { "type": "string", "minLength": 1, "maxLength": 160 },
    "os_id": { "type": "string", "minLength": 1, "maxLength": 40 },
    "os_version_id": { "type": "string", "minLength": 1, "maxLength": 40 },
    "os_version_codename": { "type": "string", "minLength": 1, "maxLength": 80 },
    "os_id_like": { "type": "string", "maxLength": 160 },
    "raw_architecture": { "type": "string", "minLength": 1, "maxLength": 40 },
    "architecture": { "enum": ["amd64", "arm64", "armv7", "386", "unknown"] },
    "package_manager": { "enum": ["apt", "dnf", "yum", "zypper", "apk", "pacman", "unknown"] },
    "service_manager": { "enum": ["systemd", "openrc", "sysvinit", "unknown"] },
    "os_support_policy_version": { "const": "1.0.0" },
    "os_support_status": { "enum": ["Supported", "Unsupported", "Unknown"] },
    "cpu_cores": { "type": "integer", "minimum": 0 },
    "memory_bytes": { "type": "integer", "minimum": 0 },
    "root_available_bytes": { "type": "integer", "minimum": 0 },
    "bench_available": { "type": "boolean" }
  }
}
